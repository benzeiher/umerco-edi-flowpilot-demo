interface testFlows

service tryFinallyExample (
    input {
        String num1;
        String num2;
    }
    output {
        String result;
        String status;
    }
) {
    TRY {
        INVOKE pub.math:addInts {
            input {
                mapSource {
                    String num1;
                    String num2;
                }
                mapTarget {
                    String num1;
                    String num2;
                }
                copy num1 -> num1;
                copy num2 -> num2;
            }
            output {
                mapSource {
                    String value;
                }
                mapTarget {
                    String result;
                }
                copy value -> result;
            }
        }
    }
    FINALLY {
        MAP {
            mapTarget {
                String status;
            }
            set status = "COMPLETED";
        }
        INVOKE pub.flow:debugLog {
            input {
                mapTarget {
                    String message;
                }
                set message = "Try-Finally execution completed";
            }
        }
    }
}
