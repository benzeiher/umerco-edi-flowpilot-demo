interface ediDemo
service mapEDI850Flow (
    input {
        String ediDocument;
    }
    output {
        String jsonOutput;
    }
)
properties {
    comment: "Parses an X12 850 purchase order string into a flat JSON string carrying the ISA sender/receiver/control number and the BEG purchase order number and date.";
    favorite: false;
    deprecated: false;
    visible: public;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    pipelineDebug: None;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: never;
    logOn: Error only;
    includePipeline: never;
    circuitBreakerEnabled: false;
    failureEvent: Exception only;
    timeoutPeriod: 60;
    cancelThreadOnTimeout: false;
    failureThreshold: 5;
    failurePeriod: 60;
    circuitOpenAction: Throw exception;
    circuitResetPeriod: 300;
    concurrencyEnabled: false;
    maxConcurrentRequests: 20;
    validateInput: false;
    validateOutput: false;
}
{
    INVOKE pub.string:tokenize {
        validateInput: false
        validateOutput: false
        input {
            copy `ediDocument` -> `inString`;
            set `delim` = "~";
        }
        output {
            mapTarget {
                String[] segmentList;
            }
            copy `valueList` -> `segmentList`;
        }
    }
    LOOP {
        inputArray: "/segmentList"
        maxThreads: "1"
        parallelErrorHandling: "reportError"
        INVOKE pub.string:trim {
            validateInput: false
            validateOutput: false
            input {
                copy `segmentList` -> `inString`;
            }
            output {
                mapTarget {
                    String segment;
                }
                copy `value` -> `segment`;
            }
        }
        INVOKE pub.string:tokenize {
            validateInput: false
            validateOutput: false
            input {
                copy `segment` -> `inString`;
                set `delim` = "*";
            }
            output {
                mapTarget {
                    String[] elementList;
                }
                copy `valueList` -> `elementList`;
            }
        }
        MAP {
            mapTarget {
                String segmentId;
            }
            set (variable) `segmentId` = "%elementList[0]%";
        }
        BRANCH {
            switch: "/segmentId"
            SEQUENCE {
                label: "ISA"
                MAP {
                    mapTarget {
                        String senderId;
                        String receiverId;
                        String controlNumber;
                    }
                    set (variable) `senderId` = "%elementList[6]%";
                    set (variable) `receiverId` = "%elementList[8]%";
                    set (variable) `controlNumber` = "%elementList[13]%";
                }
            }
            SEQUENCE {
                label: "BEG"
                MAP {
                    mapTarget {
                        String poNumber;
                        String poDate;
                    }
                    set (variable) `poNumber` = "%elementList[3]%";
                    set (variable) `poDate` = "%elementList[4]%";
                }
            }
        }
    }
    MAP {
        mapSource {
            String senderId;
            String receiverId;
            String controlNumber;
            String poNumber;
            String poDate;
        }
        mapTarget {
            record purchaseOrder {
                String senderId;
                String receiverId;
                String controlNumber;
                String poNumber;
                String poDate;
            };
        }
        copy senderId -> purchaseOrder/senderId;
        copy receiverId -> purchaseOrder/receiverId;
        copy controlNumber -> purchaseOrder/controlNumber;
        copy poNumber -> purchaseOrder/poNumber;
        copy poDate -> purchaseOrder/poDate;
    }
    INVOKE pub.json:documentToJSONString {
        validateInput: false
        validateOutput: false
        input {
            mapSource {
                record purchaseOrder {
                };
            }
            mapTarget {
                record `document` {
                };
            }
            copy purchaseOrder -> `document`;
        }
        output {
            mapSource {
                String jsonString;
            }
            mapTarget {
                String jsonOutput;
            }
            copy jsonString -> jsonOutput;
        }
    }
}
