interface ediDemo
service mapEDI850flow (
    input {
        String ediDocument;
    }
    output {
        String jsonOutput;
    }
)
properties {
    favorite: false;
    deprecated: false;
    visible: public;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    pipelineDebug: None;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: never;
    logOn: Error only;
    includePipeline: never;
    circuitBreakerEnabled: false;
    failureEvent: Exception only;
    timeoutPeriod: 60;
    cancelThreadOnTimeout: false;
    failureThreshold: 5;
    failurePeriod: 60;
    circuitOpenAction: Throw exception;
    circuitResetPeriod: 300;
    concurrencyEnabled: false;
    maxConcurrentRequests: 20;
    validateInput: false;
    validateOutput: false;
}
{
    SEQUENCE {
        INVOKE pub.flow:debugLog {
            validateInput: false
            validateOutput: false
            input {
                mapTarget {
                    String message;
                    String level;
                }
                set `message` = "[mapEDI850Flow] started";
                set `level` = "DEBUG";
            }
        }
        INVOKE pub.string:trim {
            validateInput: false
            validateOutput: false
            input {
                mapTarget {
                    String inString;
                }
                copy `ediDocument` -> `inString`;
            }
            output {
                mapTarget {
                    String ediText;
                }
                copy `value` -> `ediText`;
                drop `value`;
                drop `inString`;
            }
        }
        INVOKE pub.string:tokenize {
            validateInput: false
            validateOutput: false
            input {
                mapTarget {
                    String inString;
                    String delim;
                }
                copy `ediText` -> `inString`;
                set `delim` = "~";
            }
            output {
                mapTarget {
                    Object segmentList;
                }
                copy `valueList` -> `segmentList`;
                drop `valueList`;
                drop `inString`;
                drop `delim`;
                drop `ediText`;
            }
        }
        LOOP {
            inputArray: "/segmentList"
            maxThreads: "1"
            parallelErrorHandling: "reportError"
            INVOKE pub.string:trim {
                validateInput: false
                validateOutput: false
                input {
                    mapTarget {
                        String inString;
                    }
                    copy `segmentList` -> `inString`;
                }
                output {
                    mapTarget {
                        String segment;
                    }
                    copy `value` -> `segment`;
                    drop `value`;
                    drop `inString`;
                }
            }
            INVOKE pub.string:substring {
                validateInput: false
                validateOutput: false
                input {
                    mapTarget {
                        String inString;
                        String beginIndex;
                        String endIndex;
                    }
                    copy `segment` -> `inString`;
                    set `beginIndex` = "0";
                    set `endIndex` = "3";
                }
                output {
                    mapTarget {
                        String segmentId;
                    }
                    copy `value` -> `segmentId`;
                    drop `value`;
                    drop `inString`;
                    drop `beginIndex`;
                    drop `endIndex`;
                }
            }
            BRANCH {
                switch: "/segmentId"
                INVOKE ediDemo:captureIsaHeader {
                    label: "ISA"
                    validateInput: false
                    validateOutput: false
                    input {
                        mapTarget {
                            String isaSegment;
                        }
                        copy `segment` -> `isaSegment`;
                    }
                }
            }
        }
        INVOKE pub.json:documentToJSONString {
            validateInput: false
            validateOutput: false
            input {
                mapTarget {
                    String prettyPrint;
                }
                set `prettyPrint` = "false";
            }
            output {
                mapTarget {
                    String jsonOutput;
                }
                copy `jsonString` -> `jsonOutput`;
                drop `jsonString`;
                drop `document`;
                drop `prettyPrint`;
                drop `segmentList`;
                drop `segment`;
                drop `segmentId`;
                drop `senderId`;
                drop `receiverId`;
                drop `controlNumber`;
            }
        }
        INVOKE pub.flow:debugLog {
            validateInput: false
            validateOutput: false
            input {
                mapTarget {
                    String message;
                    String level;
                }
                set `message` = "[mapEDI850Flow] finished";
                set `level` = "DEBUG";
            }
        }
    }
}
