interface ediDemo
service mapEDI850Flow
properties {
    visible: private;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: never;
    logOn: Error only;
    includePipeline: never;
    validateInput: false;
    validateOutput: false;
}
{
    INVOKE pub.string:tokenize {
        validateInput: false
        validateOutput: false
        input {
            mapTarget {
                String delim;
            }
            copy `ediDocument` -> `inString`;
            set `delim` = "~";
        }
        output {
            mapTarget {
                String[] segmentList;
            }
            copy `valueList` -> `segmentList`;
        }
    }
    LOOP {
        comment: "One iteration per X12 segment. Segments arrive newline-separated, so each is trimmed before its elements are split on *."
        inputArray: "/segmentList"
        maxThreads: "1"
        parallelErrorHandling: "reportError"
        MAP {
            mapTarget {
                String currentSegment;
            }
            set (variable) `currentSegment` = "%segmentList[$iterationCount]%";
        }
        INVOKE pub.string:trim {
            validateInput: false
            validateOutput: false
            input {
                copy `currentSegment` -> `inString`;
            }
            output {
                mapTarget {
                    String trimmedSegment;
                }
                copy `value` -> `trimmedSegment`;
            }
        }
        INVOKE pub.string:tokenize {
            validateInput: false
            validateOutput: false
            input {
                copy `trimmedSegment` -> `inString`;
                set `delim` = "*";
            }
            output {
                mapTarget {
                    String[] elementList;
                }
                copy `valueList` -> `elementList`;
            }
        }
        MAP {
            mapTarget {
                String segmentId;
            }
            set (variable) `segmentId` = "%elementList[0]%";
        }
        BRANCH {
            comment: "Segment dispatch on the X12 segment id. ISA is the interchange envelope, BEG is the beginning-of-purchase-order segment. Every other segment is ignored."
            switch: "/segmentId"
            SEQUENCE {
                label: "ISA"
                MAP {
                    mapTarget {
                        String senderId;
                        String receiverId;
                        String controlNumber;
                    }
                    set (variable) `senderId` = "%elementList[6]%";
                    set (variable) `receiverId` = "%elementList[8]%";
                    set (variable) `controlNumber` = "%elementList[13]%";
                }
            }
            SEQUENCE {
                label: "BEG"
                MAP {
                    mapTarget {
                        String poNumber;
                        String poDate;
                    }
                    set (variable) `poNumber` = "%elementList[3]%";
                    set (variable) `poDate` = "%elementList[4]%";
                }
            }
        }
    }
    MAP {
        mapTarget {
            String jsonOutput;
        }
        set (variable) `jsonOutput` = {`senderId`:"%senderId%",`receiverId`:"%receiverId%",`controlNumber`:"%controlNumber%",`poNumber`:"%poNumber%",`poDate`:"%poDate%"};
    }
}
