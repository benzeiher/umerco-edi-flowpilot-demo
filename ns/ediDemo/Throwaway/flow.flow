interface ediDemo
service Throwaway (
)
properties {
    favorite: false;
    deprecated: false;
    visible: private;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    pipelineDebug: None;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: never;
    logOn: Error only;
    includePipeline: never;
    circuitBreakerEnabled: false;
    failureEvent: Exception only;
    timeoutPeriod: 60;
    cancelThreadOnTimeout: false;
    failureThreshold: 5;
    failurePeriod: 60;
    circuitOpenAction: Throw exception;
    circuitResetPeriod: 300;
    concurrencyEnabled: false;
    maxConcurrentRequests: 20;
    validateInput: false;
    validateOutput: false;
}
{
    BRANCH {
        switch: "/segmentId"
        INVOKE ediDemo:Throwaway {
            label: "BEG"
            validateInput: false
            validateOutput: false
        }
        INVOKE ediDemo:Throwaway {
            label: "$default"
            validateInput: false
            validateOutput: false
        }
    }
    SEQUENCE {
        INVOKE ediDemo:Throwaway {
            validateInput: false
            validateOutput: false
        }
        IF (isValid=true) {
            INVOKE ediDemo:Throwaway {
                validateInput: false
                validateOutput: false
            }
            LOOP {
                inputArray: "/segments"
                maxThreads: "1"
                parallelErrorHandling: "reportError"
                INVOKE ediDemo:Throwaway {
                    validateInput: false
                    validateOutput: false
                }
            }
        }
    }
}
